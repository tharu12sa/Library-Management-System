<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="680.0" prefWidth="906.0" styleClass="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="contollers.member.MemberPageController">
    <children>
        <VBox layoutY="36.0" prefHeight="645.0" prefWidth="202.0" styleClass="sidebar">
            <children>
                <Button fx:id="btnDashBoard" alignment="CENTER" mnemonicParsing="false" onAction="#btnDashBoardOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="DashBoard">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="btnAddBook" alignment="CENTER" layoutX="10.0" layoutY="30.0" mnemonicParsing="false" onAction="#btnAddBookOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="Books">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="btnAddMembers" alignment="CENTER" layoutX="10.0" layoutY="68.0" mnemonicParsing="false" onAction="#btnAddMembersOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="Members">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="btnView" alignment="CENTER" layoutX="10.0" layoutY="107.0" mnemonicParsing="false" onAction="#btnViewOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="View">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="btnIssueBook" alignment="CENTER" layoutX="10.0" layoutY="145.0" mnemonicParsing="false" onAction="#btnIssueBookOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="Issue Book">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="btnReturnBook" alignment="CENTER" layoutX="10.0" layoutY="184.0" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="Return Book">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
            <Button fx:id="btnHistory" alignment="CENTER" layoutX="11.0" layoutY="275.0" mnemonicParsing="false" onAction="#btnHistoryOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="History">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
            </children></VBox>
        <Label alignment="CENTER" layoutX="386.0" layoutY="14.0" prefHeight="30.0" prefWidth="222.0" styleClass="form-title" text="Member Page">
            <font>
                <Font name="Bookman Old Style Bold" size="12.0" />
            </font>
        </Label>
      <Pane layoutX="255.0" layoutY="101.0" prefHeight="487.0" prefWidth="597.0" styleClass="form-card">
         <children>
            <Label layoutX="45.0" layoutY="27.0" prefHeight="15.0" prefWidth="173.0" styleClass="field-label" text="Member Name  *" />
            <TextField fx:id="txtName" layoutX="45.0" layoutY="54.0" prefHeight="23.0" prefWidth="173.0" styleClass="modern-input" />
            <Label layoutX="385.0" layoutY="27.0" prefHeight="15.0" prefWidth="173.0" styleClass="field-label" text="NIC Number  *" />
            <TextField fx:id="txtNIC" layoutX="385.0" layoutY="54.0" prefHeight="23.0" prefWidth="173.0" styleClass="modern-input" />
            <Label layoutX="45.0" layoutY="104.0" prefHeight="15.0" prefWidth="173.0" styleClass="field-label" text="Email Address  *" />
            <TextField fx:id="txtEmail" layoutX="45.0" layoutY="130.0" prefHeight="23.0" prefWidth="173.0" styleClass="modern-input" />
            <Label layoutX="385.0" layoutY="104.0" prefHeight="15.0" prefWidth="173.0" styleClass="field-label" text="Date Of Birth" />
            <DatePicker fx:id="dateBirth" layoutX="385.0" layoutY="130.0" prefHeight="23.0" prefWidth="173.0" styleClass="modern-date-picker" />
            <Label layoutX="45.0" layoutY="264.0" prefHeight="15.0" prefWidth="173.0" styleClass="field-label" text="Address  *" />
            <TextArea fx:id="txtAddress" layoutX="39.0" layoutY="294.0" prefHeight="37.0" prefWidth="358.0" styleClass="modern-textarea" />
            <Label layoutX="45.0" layoutY="181.0" prefHeight="15.0" prefWidth="173.0" styleClass="field-label" text="Member ID" />
            <TextField fx:id="txtMemberID" layoutX="45.0" layoutY="213.0" prefHeight="23.0" prefWidth="173.0" styleClass="modern-input" />
            <Label layoutX="385.0" layoutY="181.0" prefHeight="15.0" prefWidth="173.0" styleClass="field-label" text="Generate Member ID" />
            <Button fx:id="btnGenerateID" layoutX="385.0" layoutY="213.0" mnemonicParsing="false" prefHeight="23.0" prefWidth="173.0" styleClass="btn-generate" text="Generate ID" />
            <Button layoutX="408.0" layoutY="403.0" mnemonicParsing="false" onAction="#btnSaveMemberOnAction" prefHeight="39.0" prefWidth="150.0" styleClass="btn-save" text="Save Member" />
            <Button layoutX="39.0" layoutY="403.0" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="23.0" prefWidth="119.0" styleClass="btn-clear" text="Clear form" />
         </children>
      </Pane>
    </children>
   <stylesheets>
      <URL value="@../css/main-ui.css" />
      <URL value="@../css/bookPage%20and%20memberPage.css" />
   </stylesheets>
</AnchorPane>
