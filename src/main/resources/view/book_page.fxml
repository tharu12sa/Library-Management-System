<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="680.0" prefWidth="906.0" styleClass="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="contollers.book.BookPageController">
    <children>
        <VBox layoutY="36.0" prefHeight="645.0" prefWidth="202.0" style="-fx-border-color: #1123;" styleClass="sidebar">
            <children>
                <Button fx:id="btnDashBoard" alignment="CENTER" mnemonicParsing="false" onAction="#btnDashBoardOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="DashBoard">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="btnAddBook" alignment="CENTER" layoutX="10.0" layoutY="30.0" mnemonicParsing="false" onAction="#btnAddBookOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="Books">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="btnAddMembers" alignment="CENTER" layoutX="10.0" layoutY="68.0" mnemonicParsing="false" onAction="#btnAddMembersOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="Members">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="btnView" alignment="CENTER" layoutX="10.0" layoutY="107.0" mnemonicParsing="false" onAction="#btnViewOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="View">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="btnIssueBook" alignment="CENTER" layoutX="10.0" layoutY="145.0" mnemonicParsing="false" onAction="#btnIssueBookOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="Issue Book">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
                <Button fx:id="btnReturnBook" alignment="CENTER" layoutX="10.0" layoutY="184.0" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="Return Book">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
            <Button fx:id="btnHistory" alignment="CENTER" layoutX="11.0" layoutY="275.0" mnemonicParsing="false" onAction="#btnHistoryOnAction" prefHeight="38.0" prefWidth="202.0" styleClass="nav-button" text="History">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Button>
            </children></VBox>
      <Label alignment="CENTER" layoutX="386.0" layoutY="14.0" prefHeight="30.0" prefWidth="222.0" styleClass="form-title" text="Book Page">
         <font>
            <Font name="Bookman Old Style Bold" size="12.0" />
         </font>
      </Label>
      <AnchorPane layoutX="204.0" layoutY="77.0" prefHeight="605.0" prefWidth="701.0">
         <children>
            <Pane layoutX="56.0" layoutY="89.0" prefHeight="473.0" prefWidth="590.0" styleClass="form-card">
               <children>
                  <TextField fx:id="addBookID" layoutX="36.0" layoutY="272.0" prefHeight="23.0" prefWidth="184.0" styleClass="modern-input" />
                  <Label layoutX="36.0" layoutY="250.0" prefHeight="15.0" prefWidth="184.0" styleClass="field-label" text="Book Id  *            " />
                  <Label layoutX="36.0" layoutY="23.0" prefHeight="15.0" prefWidth="184.0" styleClass="field-label" text="Book Title  *" />
                  <TextField fx:id="addBookTitle" layoutX="36.0" layoutY="64.0" prefHeight="23.0" prefWidth="184.0" styleClass="modern-input" />
                  <Label layoutX="36.0" layoutY="101.0" prefHeight="15.0" prefWidth="184.0" styleClass="field-label" text="Author  *        " />
                  <TextField fx:id="addAuthor" layoutX="36.0" layoutY="125.0" prefHeight="23.0" prefWidth="184.0" styleClass="modern-input" />
                  <Label layoutX="348.0" layoutY="31.0" prefHeight="15.0" prefWidth="184.0" styleClass="field-label" text="Category  *" />
                  <ComboBox fx:id="addCategory" layoutX="336.0" layoutY="64.0" prefHeight="23.0" prefWidth="184.0" styleClass="modern-date-picker" />
                  <Label layoutX="36.0" layoutY="178.0" prefHeight="15.0" prefWidth="184.0" styleClass="field-label" text=" Published Year  *" />
                  <DatePicker fx:id="addYear" layoutX="36.0" layoutY="199.0" prefHeight="23.0" prefWidth="184.0" styleClass="modern-date-picker" />
                  <Label layoutX="336.0" layoutY="101.0" prefHeight="15.0" prefWidth="184.0" styleClass="field-label" text="Quantity  *" />
                  <TextField fx:id="addquantity" layoutX="336.0" layoutY="125.0" prefHeight="23.0" prefWidth="184.0" styleClass="modern-input" />
                  <Button layoutX="396.0" layoutY="358.0" mnemonicParsing="false" onAction="#addBookOnAction" prefHeight="39.0" prefWidth="124.0" styleClass="btn-save" text="Save book" />
                  <Label layoutX="336.0" layoutY="178.0" prefHeight="15.0" prefWidth="184.0" styleClass="field-label" text="Book Id Generate" />
                  <Button layoutX="336.0" layoutY="198.0" mnemonicParsing="false" onAction="#btnBookIDGenerateOnAction" prefHeight="9.0" prefWidth="184.0" styleClass="btn-generate" text="Generate" />
                  <Button layoutX="205.0" layoutY="358.0" mnemonicParsing="false" onAction="#clearFromOnAction" prefHeight="39.0" prefWidth="117.0" styleClass="btn-clear" text="Clear Form" />
               </children>
            </Pane>
         </children>
      </AnchorPane>
    </children>
   <stylesheets>
      <URL value="@../css/main-ui.css" />
      <URL value="@../css/bookPage.css" />
   </stylesheets>
</AnchorPane>
